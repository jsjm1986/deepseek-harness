# DeepSeek Harness portal gateway — systemd unit (Linux production).
# Install: copy to /etc/systemd/system/, adjust paths/env, then
#   systemctl daemon-reload && systemctl enable --now harness-gateway
# The gateway runs as root: it writes per-user unit files, provisions system
# accounts, and drives systemctl. Its listen socket stays loopback-only; the
# public entry (Nginx / Cloudflare Tunnel) terminates TLS and connects to
# 127.0.0.1:8899.
[Unit]
Description=DeepSeek Harness portal gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/harness/gateway
Environment=HGW_PORT=8899
Environment=HGW_PUBLIC_ORIGINS=https://harness.example.com
Environment=HGW_DATABASE_URL_FILE=/srv/harness/gateway-data/database-url
Environment=HGW_ORGANIZATION_SLUG=default
Environment=HGW_COMPUTE_NODE_NAME=local
Environment=HGW_USERS_ROOT=/srv/harness/users
Environment=HGW_PROJECT_RUNTIMES_ROOT=/srv/harness/project-runtimes
Environment=HGW_PROJECT_PATH_ROOTS=/srv/harness
Environment=HGW_PROJECTS_ROOT=/srv/harness/projects/admin
Environment=HGW_USER_PROJECTS_ROOT=/srv/harness/projects/user-projects
Environment=HGW_PROJECT_RUNTIME_USER=harness-project
Environment=HGW_PRINCIPAL_KEY_DIR=/srv/harness/gateway-data/principal-keys
Environment=HGW_RUNTIME_CREDENTIAL_DIR=/srv/harness/gateway-data/runtime-credentials
Environment=HGW_LAUNCHER=systemd
# Pinned npm dsh (never the source tree): install with
#   npm install -g @deepseek-ai/dsh@<pinned>
Environment=HGW_DSH_COMMAND=/usr/local/bin/dsh web --port {port}
Environment=HGW_GUARD_PATCH=/srv/harness/plugins/dsh-directory-guard/cordis.patch.yml
Environment=HGW_MODEL_GOVERNANCE_PACKAGE=/srv/harness/plugins/dsh-model-governance
Environment=HGW_USAGE_TIME_ZONE=Asia/Shanghai
Environment=HGW_DEFAULT_ENV_FILE=/srv/harness/gateway-data/company.env
ExecStart=/usr/local/bin/node --import tsx/esm src/index.ts
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
